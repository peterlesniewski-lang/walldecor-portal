# Copy this file to .env and fill in your values
# .env is gitignored and never committed

NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Database
DB_TYPE=sqlite
DB_PATH=walldecor.sqlite

# Optional integrations
GEMINI_API_KEY=your-gemini-api-key-here

DEMO_MODE=false

# Google OAuth (required for Google sign-in)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (required for password reset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="WallDecor - Portal Architekta" <no-reply@walldecor.pl>

# Tryb wewnętrzny (start produkcji tylko dla zespołu): 1 lub true → maile wyłącznie do ADMIN/STAFF,
# architekci (ARCHI) nie logują się i nie resetują hasła, w panelu plakietka „Tryb wewnętrzny”.
# Puste / brak → zwykłe działanie portalu.
PORTAL_INTERNAL_MODE=

# Ważność nowego cashbacku w miesiącach (domyślnie 12; nieliczbowa lub ≤ 0 → 12 z ostrzeżeniem).
# Dotyczy tylko nowych wpisów — istniejące expires_at w bazie się nie zmieniają.
CASHBACK_EXPIRY_MONTHS=12
