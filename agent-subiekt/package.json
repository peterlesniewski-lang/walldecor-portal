{
  "name": "walldecor-agent-subiekt",
  "version": "0.1.0",
  "private": true,
  "description": "Agent synchronizacji Subiekt GT → Portal Architekta (tylko odczyt bazy GT).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync": "node dist/main.js",
    "probe": "node dist/main.js --probe",
    "dry-run": "node dist/main.js --dry-run",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "mssql": "12.7.2"
  },
  "devDependencies": {
    "@types/mssql": "9.1.11",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
