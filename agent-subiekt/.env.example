# Konfiguracja agenta Subiekt GT → Portal Architekta. Skopiuj ten plik jako .env i uzupełnij.
# Wartość z # lub spacją ujmij w cudzysłów, np. SUBIEKT_DB_PASSWORD="ab#cd ef".

# --- Baza Subiekta GT (tylko odczyt) ---
# Serwer i nazwana instancja SQL (agent działa na tym samym komputerze co baza).
SUBIEKT_DB_SERVER=localhost
SUBIEKT_DB_INSTANCE=INSERTGT
# Tylko gdy połączenie przez instancję nie działa: stały port TCP instancji (wtedy SUBIEKT_DB_INSTANCE jest pomijane).
# SUBIEKT_DB_PORT=
SUBIEKT_DB_NAME=WD_sp
SUBIEKT_DB_USER=portal_reader
SUBIEKT_DB_PASSWORD=

# --- Portal (potrzebne tylko do synchronizacji; --probe i --dry-run działają bez tych wartości) ---
# Adres portalu bez ścieżki, np. https://archi.walldecor.pl
PORTAL_URL=
# Token i sekret — te same wartości co SUBIEKT_SYNC_TOKEN / SUBIEKT_SYNC_SECRET w konfiguracji portalu.
SUBIEKT_SYNC_TOKEN=
SUBIEKT_SYNC_SECRET=

# --- Wybór dokumentów ---
# Ile miesięcy wstecz czytać dokumenty (parametr --since RRRR-MM-DD nadpisuje).
LOOKBACK_MONTHS=18
# kat_Id kategorii dokumentu „Architekt” w sl_Kategoria (zweryfikowano 30.10.2026: 14).
ARCHITECT_CATEGORY_ID=14
